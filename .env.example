# Tiny Isles 환경변수 예시 (.env.local / Vercel Environment Variables)

# 1. Cloudflare Workers + Durable Objects 멀티플레이 서버 WebSocket 주소
# - 로컬 개발 시 생략하면 기본 ws://localhost:8787 사용
# - 실배포 시 wrangler deploy 후 발급된 Worker 주소를 wss:// 형태로 설정
VITE_MULTIPLAYER_WS_URL=wss://tiny-isles-multiplayer.<your-subdomain>.workers.dev

# 2. Supabase (구글/카카오 로그인 및 클라우드 세이브 전용)
VITE_SUPABASE_URL=https://<your-project>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>
